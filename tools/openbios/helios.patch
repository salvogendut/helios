         cmp     %g4, 0
-        beq     clear_mem
+        beq     prepare_clear_mem
          nop
 
         ! Start from 16M
         set     0x1000000, %g6
 
+prepare_clear_mem:
+        ! Clear the same full RAM range, using 64-byte blocks. RAM size and
+        ! either start (0 or 16 MiB) are multiples of 64. Keep %g1 (RAM end),
+        ! %g5 (configuration port) and %g7 (CPU ID) intact. The two source
+        ! registers must both be zero: stda %g0 would store RAM size as well.
