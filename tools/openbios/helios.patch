diff --git a/arch/sparc32/openbios.c b/arch/sparc32/openbios.c
index 9af4e18..98902b9 100644
--- a/arch/sparc32/openbios.c
+++ b/arch/sparc32/openbios.c
@@ -123,15 +123,34 @@ void setup_timers(void)
 {
 }
 
+/* NCR system counter: bits 30:9 count 500 ns ticks. Use the system
+ * counter rather than instruction-count delays, which fail on timed devices.
+ * The firmware owns this counter until handing control to the client. */
+static volatile uint32_t *delay_counter;
+
 void udelay(unsigned int usecs)
 {
+    if (!delay_counter) {
+        phys_addr_t base = hwdef->slavio_base + hwdef->counter_offset + 0x10000;
+        delay_counter = (volatile uint32_t *)ofmem_map_io(base, 8);
+        delay_counter[0] = 0; /* free run, no interrupt */
+    }
+    while (usecs) {
+        unsigned int chunk = usecs > 1000000 ? 1000000 : usecs;
+        uint32_t start = delay_counter[1] >> 9;
+        while (((delay_counter[1] >> 9) - start) % 0x400000 < chunk * 2)
+            ;
+        usecs -= chunk;
+    }
 }
 
 void mdelay(unsigned int msecs)
 {
+    while (msecs--)
+        udelay(1000);
 }
 
