+        stda    %g2, [%g6] ASI_M_BYPASS
+        stda    %g2, [%g6 + %g4] ASI_M_BYPASS
+        add     %g6, 16, %g6
+        stda    %g2, [%g6] ASI_M_BYPASS
+        stda    %g2, [%g6 + %g4] ASI_M_BYPASS
+        add     %g6, 16, %g6
+        stda    %g2, [%g6] ASI_M_BYPASS
+        stda    %g2, [%g6 + %g4] ASI_M_BYPASS
+        add     %g6, 16, %g6
+        stda    %g2, [%g6] ASI_M_BYPASS
+        stda    %g2, [%g6 + %g4] ASI_M_BYPASS
+        add     %g6, 16, %g6
         cmp     %g6, %g1
         bl      clear_mem
          nop
